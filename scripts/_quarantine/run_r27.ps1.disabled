# Single-instance 90k train + seed0 probe. Uses tmp/train.lock to avoid double trainers.
$ErrorActionPreference = "Continue"
Set-Location $PSScriptRoot\..
if (-not (Test-Path "Cargo.toml")) { Set-Location (Split-Path $PSScriptRoot -Parent) }

$lock = Join-Path (Get-Location) "tmp\train.lock"
New-Item -ItemType Directory -Force -Path (Join-Path (Get-Location) "tmp") | Out-Null
if (Test-Path $lock) {
  $old = Get-Content $lock -ErrorAction SilentlyContinue
  Write-Host "[lock] existing lock: $old — removing stale and continuing"
}
Set-Content -Path $lock -Value ("pid={0} at={1}" -f $PID, (Get-Date -Format o)) -Encoding ASCII

try {
  Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
  Start-Sleep 2

  $round = 27
  $target = 90000
  $logDir = Join-Path (Get-Location) "tmp"
  $exe = Join-Path (Get-Location) "target\release\neat_trainer.exe"
  $deadline = (Get-Date).AddMinutes(40)
  $fresh = -not (Test-Path (Join-Path (Get-Location) "tmp\neat_checkpoint.json"))
  $done = $false
  $run = 0

  while ((Get-Date) -lt $deadline -and -not $done) {
    $run++
    # ensure no orphans before each start
    Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    Start-Sleep 2

    $stamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $log = Join-Path $logDir ("auto_train_r{0}_run_{1}.log" -f $round, $stamp)
    $argList = New-Object System.Collections.Generic.List[string]
    [void]$argList.Add("--sim-detect")
    if ($fresh) { [void]$argList.Add("--fresh") }
    [void]$argList.AddRange([string[]]@(
      "--population","16","--workers","16","--generations","$target",
      "--detect-hz","10","--max-ticks","36000",
      "--sim-dropout","0.32","--sim-jitter","20","--sim-class-noise","0.14","--sim-size-jitter","0.25",
      "--log-file", $log
    ))
    Write-Host ("[r27] start run={0} fresh={1} log={2}" -f $run, $fresh, $log)
    $p = Start-Process -FilePath $exe -ArgumentList $argList.ToArray() -WorkingDirectory (Get-Location) -PassThru -WindowStyle Hidden
    Write-Host ("[r27] main_pid={0}" -f $p.Id)
    $fresh = $false
    $sawWorkers = $false

    while ((Get-Date) -lt $deadline) {
      Start-Sleep 20
      $mainAlive = $null -ne (Get-Process -Id $p.Id -ErrorAction SilentlyContinue)
      $workers = @(Get-Process neat_trainer -ErrorAction SilentlyContinue).Count
      if ($workers -gt 1) { $sawWorkers = $true }
      $marker = $false
      if (Test-Path $log) {
        $marker = Select-String -Path $log -Pattern "训练完成" -Quiet -ErrorAction SilentlyContinue
      }
      $tail = ""
      if (Test-Path $log) {
        $tail = (Get-Content $log -Tail 1 -ErrorAction SilentlyContinue)
      }
      Write-Host ("[r27] workers={0} main={1} done={2} | {3}" -f $workers, $mainAlive, $marker, $tail)
      if ($marker) { $done = $true; break }
      if (-not $mainAlive) {
        Write-Host "[r27] MAIN_DIED — will resume without --fresh"
        Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
        Start-Sleep 2
        if (-not $sawWorkers) {
          Write-Host "[r27] died before workers — abort"
          exit 2
        }
        break
      }
    }
  }

  if (-not $done) {
    Write-Host "[r27] TRAIN_TIMEOUT"
    Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    exit 2
  }

  Write-Host "[r27] TRAIN_DONE"
  Start-Sleep 3
  Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue

  & "$PSScriptRoot\preview_probe.ps1" -AutoTicks 7200 -Seed 0 -DetectHz 5 -AnchorOffset 0 -TimeoutSec 120
  $e0 = $LASTEXITCODE
  Write-Host "[r27] PROBE0=$e0"
  & "$PSScriptRoot\preview_probe.ps1" -AutoTicks 3600 -Seed 445 -DetectHz 10 -AnchorOffset 14 -TimeoutSec 90
  $e445 = $LASTEXITCODE
  Write-Host "[r27] PROBE445=$e445"

  if ($e0 -eq 0) { Write-Host "[r27] VERDICT=OK"; exit 0 }
  if ($e0 -eq 1) { Write-Host "[r27] VERDICT=STAGNANT"; exit 1 }
  Write-Host "[r27] VERDICT=FAIL"; exit 2
}
finally {
  Remove-Item $lock -Force -ErrorAction SilentlyContinue
}
