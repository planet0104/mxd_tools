# Train with auto-resume until 90k complete, then seed0 probe.
$ErrorActionPreference = "Continue"
Set-Location $PSScriptRoot\..
if (-not (Test-Path "Cargo.toml")) { Set-Location (Split-Path $PSScriptRoot -Parent) }

$round = 26
$targetBirths = 90000
$logDir = Join-Path (Get-Location) "tmp"
New-Item -ItemType Directory -Force -Path $logDir | Out-Null
$stamp = Get-Date -Format "yyyyMMdd_HHmmss"
$supLog = Join-Path $logDir "auto_train_r${round}_supervisor_${stamp}.log"
$exe = Join-Path (Get-Location) "target\release\neat_trainer.exe"

function Write-Sup([string]$msg) {
  $line = "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $msg
  Write-Host $line
  Add-Content -Path $supLog -Value $line -Encoding UTF8
}

function Get-BirthCount([string]$logPath) {
  if (-not (Test-Path $logPath)) { return 0 }
  $m = Select-String -Path $logPath -Pattern "出生\s+(\d+)/" -AllMatches -ErrorAction SilentlyContinue
  if (-not $m) { return 0 }
  $last = $m | Select-Object -Last 1
  return [int]$last.Matches[0].Groups[1].Value
}

function Start-Trainer([bool]$fresh, [string]$logPath) {
  $args = @(
    "--sim-detect",
    "--population","40","--workers","12","--generations","$targetBirths",
    "--detect-hz","10","--max-ticks","36000",
    "--sim-dropout","0.32","--sim-jitter","20","--sim-class-noise","0.14","--sim-size-jitter","0.25",
    "--log-file", $logPath
  )
  if ($fresh) { $args = @("--sim-detect","--fresh") + $args[1..($args.Length-1)] }
  return Start-Process -FilePath $exe -ArgumentList $args -WorkingDirectory (Get-Location) -PassThru -WindowStyle Hidden
}

Write-Sup "supervisor start round=$round"
Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
Start-Sleep 2

$hasCkpt = Test-Path (Join-Path (Get-Location) "tmp\neat_checkpoint.json")
$fresh = -not $hasCkpt
$run = 0
$deadline = (Get-Date).AddMinutes(45)
$done = $false
$activeLog = $null

while ((Get-Date) -lt $deadline -and -not $done) {
  $run++
  $runStamp = Get-Date -Format "yyyyMMdd_HHmmss"
  $activeLog = Join-Path $logDir "auto_train_r${round}_run_${runStamp}.log"
  Write-Sup ("start run={0} fresh={1} log={2}" -f $run, $fresh, $activeLog)
  $p = Start-Trainer -fresh $fresh -logPath $activeLog
  Write-Sup ("main_pid={0}" -f $p.Id)
  $fresh = $false

  do {
    Start-Sleep 15
    $mainAlive = $null -ne (Get-Process -Id $p.Id -ErrorAction SilentlyContinue)
    $workers = @(Get-Process neat_trainer -ErrorAction SilentlyContinue).Count
    $births = Get-BirthCount $activeLog
    $marker = $false
    if (Test-Path $activeLog) {
      $marker = Select-String -Path $activeLog -Pattern "训练完成" -Quiet -ErrorAction SilentlyContinue
    }
    Write-Sup ("workers={0} main={1} births={2} done={3}" -f $workers, $mainAlive, $births, $marker)
    if ($marker) { $done = $true; break }
    if (-not $mainAlive) {
      Write-Sup "MAIN_DIED will resume"
      Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
      Start-Sleep 2
      # clear orphaned inflight by brief pause; checkpoint should exist
      break
    }
  } while ((Get-Date) -lt $deadline)
}

if (-not $done) {
  Write-Sup "TRAIN_TIMEOUT"
  Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
  exit 2
}

Write-Sup "TRAIN_DONE"
Start-Sleep 3
Get-Process neat_trainer -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue

Write-Sup "probe seed=0"
& "$PSScriptRoot\preview_probe.ps1" -AutoTicks 7200 -Seed 0 -DetectHz 5 -AnchorOffset 0 -TimeoutSec 120
$prev0 = $LASTEXITCODE
Write-Sup ("PROBE0={0}" -f $prev0)
& "$PSScriptRoot\preview_probe.ps1" -AutoTicks 3600 -Seed 445 -DetectHz 10 -AnchorOffset 14 -TimeoutSec 90
$prev445 = $LASTEXITCODE
Write-Sup ("PROBE445={0}" -f $prev445)

if ($prev0 -eq 0) { Write-Sup "VERDICT=OK"; exit 0 }
if ($prev0 -eq 1) { Write-Sup "VERDICT=STAGNANT"; exit 1 }
Write-Sup "VERDICT=FAIL"; exit 2
